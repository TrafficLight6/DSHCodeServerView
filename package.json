{
  "name": "DSHCodeServerView",
  "version": "1.3.0",
  "description": "A Deepseek Harness Plugin, which make DSH having VS Code Server windows",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "supervisor.js",
    "copilot.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/contract.test.mjs && node test/docs.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "manifestVersion": 1
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "code-server",
    "vscode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrafficLight6/DSHCodeServerView.git"
  },
  "bugs": {
    "url": "https://github.com/TrafficLight6/DSHCodeServerView/issues"
  },
  "homepage": "https://github.com/TrafficLight6/DSHCodeServerView#readme",
  "license": "MIT",
  "icon": "./icon.svg"
}
